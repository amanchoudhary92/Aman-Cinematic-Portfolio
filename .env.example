# NEVER put a Neon database password or S3 secret in NEXT_PUBLIC_ variables.
# Neon dashboard → Connection Details → pooled connection string:
DATABASE_URL=postgresql://USER:PASSWORD@EP-EXAMPLE-POOLER.REGION.aws.neon.tech/neondb?sslmode=require

# Neon dashboard → Auth → enable Managed Auth; copy branch Auth base URL.
NEON_AUTH_BASE_URL=https://YOUR-AUTH-ENDPOINT/neondb/auth
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEON_AUTH_COOKIE_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
# Must match your verified Neon Auth email AND portfolio_admins SQL allowlist.cd "C:\Users\AMAN\Desktop\aman-portfolio-v5.9-neon-cloud-cms"
NEON_ADMIN_EMAIL=you@example.com

# Optional: for image uploading in admin, configure Neon Object Storage (S3-compatible).
# Dashboard → Storage → bucket / connection details:
AWS_ENDPOINT_URL_S3=https://YOUR-S3-ENDPOINT
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_KEY
AWS_REGION=us-east-2
NEON_S3_BUCKET=portfolio-media

# Use localhost here; after deployment use the final public origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
